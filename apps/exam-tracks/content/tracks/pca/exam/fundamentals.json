  {
    "id": "x-fa-hier-fed",
    "type": "single",
    "topic": "fund-architecture",
    "stem": "In hierarchical federation, what do the global Prometheus servers typically pull from the per-datacenter servers?",
    "options": [
      {
        "id": "a",
        "text": "Aggregated series from recording rules",
        "correct": true,
        "note": "Right. Detail stays local."
      },
      {
        "id": "b",
        "text": "Every raw series from every instance",
        "correct": false,
        "note": "That defeats the purpose and doesn't scale."
      },
      {
        "id": "c",
        "text": "Only the alerts each server is firing",
        "correct": false,
        "note": "Federation transfers time series."
      },
      {
        "id": "d",
        "text": "Log streams from the local exporters",
        "correct": false,
        "note": "Prometheus doesn't handle logs."
      }
    ],
    "explanation": "Hierarchical federation: local servers collect detailed data; global servers collect and store only aggregated time series from them.",
    "difficulty": 2,
    "tags": [
      "exam"
    ],
    "uses": [],
    "sources": [
      {
        "url": "https://prometheus.io/docs/prometheus/latest/federation/",
