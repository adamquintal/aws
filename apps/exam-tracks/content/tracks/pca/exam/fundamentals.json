  {
    "id": "x-fa-server-role",
    "type": "single",
    "topic": "fund-architecture",
    "stem": "Which component scrapes targets, stores time series and evaluates rules?",
    "options": [
      {
        "id": "a",
        "text": "The Prometheus server",
        "correct": true,
        "note": "Right. Scraping, TSDB and rule evaluation all live in the server."
      },
      {
        "id": "b",
        "text": "The Alertmanager cluster",
        "correct": false,
        "note": "Alertmanager handles alerts sent to it; it doesn't scrape."
      },
      {
        "id": "c",
        "text": "The Pushgateway service",
        "correct": false,
        "note": "It holds pushed metrics for scraping."
      },
      {
        "id": "d",
        "text": "A dedicated exporter",
        "correct": false,
        "note": "Exporters expose metrics for the server to scrape."
      }
    ],
    "explanation": "The Prometheus server scrapes and stores time series data and runs rules to aggregate data or generate alerts.",
