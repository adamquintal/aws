  {
    "id": "x-fa-agent",
    "type": "single",
    "topic": "fund-architecture",
    "stem": "What does Prometheus Agent mode (`--agent`) disable?",
    "options": [
      {
        "id": "a",
        "text": "Local querying, alerting and rules",
        "correct": true,
        "note": "Right. It's optimised for forwarding data."
      },
      {
        "id": "b",
        "text": "Service discovery and relabeling",
        "correct": false,
        "note": "Discovery is kept."
      },
      {
        "id": "c",
        "text": "Scraping of targets over HTTP",
        "correct": false,
        "note": "Scraping is the main thing it still does."
      },
      {
        "id": "d",
        "text": "Remote write to central storage",
        "correct": false,
        "note": "Remote write is its whole point."
      }
    ],
    "explanation": "Agent mode optimises Prometheus for remote write. It disables querying, alerting and local storage (using a customised WAL), keeping scraping and discovery.",
