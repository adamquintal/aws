  {
    "id": "x-fa-federation",
    "type": "single",
    "topic": "fund-architecture",
    "stem": "Which endpoint lets one Prometheus server scrape selected series from another?",
    "options": [
      {
        "id": "a",
        "text": "`/federate` with `match[]` selectors",
        "correct": true,
        "note": "This is the correct answer."
      },
      {
        "id": "b",
        "text": "`/api/v1/write` with a remote-write client",
        "correct": false,
        "note": "That's the remote-write receiver."
      },
      {
        "id": "c",
        "text": "`/metrics` with honor_labels set",
        "correct": false,
        "note": "That's the server's own metrics."
      },
      {
        "id": "d",
        "text": "`/api/v1/query` with a range parameter",
        "correct": false,
        "note": "That runs PromQL queries; it doesn't federate series for scraping."
      }
    ],
    "explanation": "The /federate endpoint returns current values for series selected by at least one match[] parameter. Scrape it with honor_labels: true.",
