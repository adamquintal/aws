  {
    "id": "x-dm-notation",
    "type": "single",
    "topic": "fund-data-model",
    "stem": "Which selector is equivalent to `api_http_requests_total{method=\"POST\"}`?",
    "options": [
      {
        "id": "a",
        "text": "`{__name__=\"api_http_requests_total\", method=\"POST\"}`",
        "correct": true,
        "note": "Right. The name is the __name__ label."
      },
      {
        "id": "b",
        "text": "`{__metric__=\"api_http_requests_total\", method=\"POST\"}`",
        "correct": false,
        "note": "The internal label is __name__, not __metric__."
      },
      {
        "id": "c",
        "text": "`api_http_requests_total{__name__=\"POST\"}`",
        "correct": false,
        "note": "This sets the name to POST, which is wrong."
      },
      {
        "id": "d",
        "text": "`{name=\"api_http_requests_total\", method=\"POST\"}`",
        "correct": false,
        "note": "The label is __name__, with two underscores each side."
      }
    ],
    "explanation": "Since the metric name is the __name__ label, `{__name__=\"name\", ...}` is equivalent notation.",
