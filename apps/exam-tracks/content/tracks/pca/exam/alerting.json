  {
    "id": "x-ar-for",
    "type": "single",
    "topic": "alert-rules",
    "stem": "What does `for: 10m` do in an alerting rule?",
    "options": [
      {
        "id": "a",
        "text": "The alert fires for exactly 10 minutes",
        "correct": false,
        "note": "It controls when firing starts."
      },
      {
        "id": "b",
        "text": "The rule is evaluated every 10 minutes",
        "correct": false,
        "note": "That's the group interval."
      },
      {
        "id": "c",
        "text": "Notifications repeat every 10 minutes",
        "correct": false,
        "note": "That's Alertmanager's repeat_interval."
      },
      {
        "id": "d",
        "text": "The condition must hold 10m before firing",
        "correct": true,
        "note": "This is the correct answer."
      }
    ],
    "explanation": "The for clause makes Prometheus wait for an alert's condition to be active for a duration before firing; meanwhile the alert is pending.",
    "difficulty": 1,
    "tags": [
      "exam"
    ],
    "uses": [],
    "sources": [
      {
        "url": "https://prometheus.io/docs/prometheus/latest/configuration/alerting_rules/",
        "title": "Alerting rules"
      }
    ],
    "status": "source-checked",
    "reviewer": null,
    "version": 1
  },
  {
    "id": "x-ar-states",
    "type": "single",
    "topic": "alert-rules",
    "stem": "An alert's expression just became true and the rule has a `for` clause. What state is the alert in?",
    "options": [
      {
        "id": "a",
        "text": "Firing",
        "correct": false,
        "note": "Only after the for duration."
      },
      {
        "id": "b",
        "text": "Pending",
        "correct": true,
        "note": "This is the correct answer."
      },
      {
        "id": "c",
        "text": "Resolved",
        "correct": false,
        "note": "It just started."
      },
      {
        "id": "d",
        "text": "Silenced",
        "correct": false,
        "note": "Silences are applied in Alertmanager."
      }
    ],
    "explanation": "Alerts whose condition is met but haven't been active for the for duration are in the pending state; then they become firing.",
    "difficulty": 1,
    "tags": [
