    "id": "x-ab-stack",
    "type": "single",
    "topic": "alert-basics",
    "stem": "Where in the stack should you page on latency?",
    "options": [
      {
        "id": "a",
        "text": "At every layer, each with its own alert",
        "correct": false,
        "note": "That multiplies pages for one problem."
      },
      {
        "id": "b",
        "text": "Once, as high in the stack as possible",
        "correct": true,
        "note": "Right. Lower components being slow doesn't matter if users are fine."
      },
      {
        "id": "c",
        "text": "Never; latency is too noisy to alert on",
        "correct": false,
        "note": "It's a key symptom."
      },
      {
        "id": "d",
        "text": "Only at the database, where it starts",
        "correct": false,
        "note": "Users experience the top of the stack."
      }
    ],
    "explanation": "Only page on latency at one point in a stack. If a lower-level component is slow but overall user latency is fine, there's no need to page.",
