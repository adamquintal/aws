[
  {
    "id": "x-ab-symptoms",
    "type": "single",
    "topic": "alert-basics",
    "stem": "According to Prometheus alerting practice, what should you mainly alert on?",
    "options": [
      {
        "id": "a",
        "text": "Every cause, such as each component's CPU",
        "correct": false,
        "note": "That creates noisy, unactionable pages."
      },
      {
        "id": "b",
        "text": "Any log line that contains ERROR",
        "correct": false,
        "note": "Not the guidance, and not a metric."
      },
      {
        "id": "c",
        "text": "Every restart of any scrape target",
        "correct": false,
        "note": "Usually invisible to users."
      },
      {
        "id": "d",
        "text": "Symptoms that users feel, like errors",
        "correct": true,
        "note": "This is the correct answer."
      }
    ],
    "explanation": "Aim to have as few alerts as possible, by alerting on symptoms associated with end-user pain rather than every possible cause.",
    "difficulty": 1,
