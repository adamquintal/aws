  {
    "id": "x-ar-keep-firing",
    "type": "single",
    "topic": "alert-rules",
    "stem": "An alert resolves and re-fires whenever a scrape is missed, spamming the team. Which rule field addresses this?",
    "options": [
      {
        "id": "a",
        "text": "`for`",
        "correct": false,
        "note": "for delays the first firing; it doesn't stop a gap from resolving it."
      },
      {
        "id": "b",
        "text": "`annotations`",
        "correct": false,
        "note": "Annotations are descriptive text."
      },
      {
        "id": "c",
        "text": "`keep_firing_for`",
        "correct": true,
        "note": "Right. It keeps the alert firing through short gaps."
      },
      {
        "id": "d",
        "text": "`labels`",
        "correct": false,
        "note": "Labels change routing, not when it resolves."
      }
    ],
    "explanation": "keep_firing_for keeps an alert firing for a duration after its condition was last met, which helps with flapping or gaps in data.",
    "difficulty": 2,
    "tags": [
      "exam"
    ],
    "uses": [],
    "sources": [
