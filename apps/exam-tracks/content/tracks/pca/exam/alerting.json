  {
    "id": "x-db-rate-graph",
    "type": "single",
    "topic": "alert-dashboarding",
    "stem": "A panel shows `rate(http_requests_total[5m])` with hundreds of lines, one per instance and path. The team wants one line per service. What's the fix?",
    "options": [
      {
        "id": "a",
        "text": "`sum by (job) (rate(http_requests_total[5m]))`",
        "correct": true,
        "note": "Right. rate first, then aggregate."
      },
      {
        "id": "b",
        "text": "`count by (job) (rate(http_requests_total[5m]))`",
        "correct": false,
        "note": "That counts series instead of adding rates."
      },
      {
        "id": "c",
        "text": "`avg by (job) (http_requests_total)`",
        "correct": false,
        "note": "That's a raw counter, not a rate."
      },
      {
        "id": "d",
        "text": "`rate(sum by (job) (http_requests_total)[5m])`",
        "correct": false,
        "note": "Summing before rate hides counter resets, and isn't valid as written."
      }
    ],
    "explanation": "Always take rate() first, then aggregate. sum by (job) gives one line per job.",
