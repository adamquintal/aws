  {
    "id": "x-cl-labeled-init",
    "type": "single",
    "topic": "instr-client-libs",
    "stem": "A counter has a `result` label with values success and failure. Failures are rare. What should you do so alerts on failures work reliably?",
    "options": [
      {
        "id": "a",
        "text": "Initialise both label values to 0 at startup",
        "correct": true,
        "note": "Right. Missing series are hard to query."
      },
      {
        "id": "b",
        "text": "Create the failure series on the first failure",
        "correct": false,
        "note": "Then rate() and ratios break until it appears."
      },
      {
        "id": "c",
        "text": "Use a gauge set to 1 while failures happen",
        "correct": false,
        "note": "Doesn't solve the missing-series problem, and loses counts."
      },
      {
        "id": "d",
        "text": "Add a timestamp label to each failure series",
        "correct": false,
        "note": "That would explode cardinality."
      }
    ],
    "explanation": "Avoid missing metrics: export a default value such as 0 for any time series you know may exist in advance.",
    "difficulty": 2,
    "tags": [
      "exam"
    ],
    "uses": [],
    "sources": [
      {
        "url": "https://prometheus.io/docs/practices/instrumentation/",
        "title": "Instrumentation"
      }
    ],
    "status": "source-checked",
    "reviewer": null,
    "version": 1
  },
