  {
    "id": "x-cl-what",
    "type": "single",
    "topic": "instr-client-libs",
    "stem": "What does a Prometheus client library do inside your application?",
    "options": [
      {
        "id": "a",
        "text": "Defines metrics and serves them over HTTP",
        "correct": true,
        "note": "This is the correct answer."
      },
      {
        "id": "b",
        "text": "Pushes metrics to Prometheus every few seconds",
        "correct": false,
        "note": "Client libraries expose metrics for pulling by default."
      },
      {
        "id": "c",
        "text": "Stores metrics in a local time series database",
        "correct": false,
        "note": "The Prometheus server stores data."
      },
      {
        "id": "d",
        "text": "Evaluates alerting rules inside the application",
        "correct": false,
        "note": "That's the server."
      }
    ],
    "explanation": "Client libraries let you define and expose internal metrics via an HTTP endpoint on your application's instance, serving current state when scraped.",
