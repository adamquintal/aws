  {
    "id": "x-ip-histogram-vs-summary",
    "type": "single",
    "topic": "instr-instrumentation",
    "stem": "You know the latency target is 300 ms but need to aggregate across instances. What's the better instrumentation choice?",
    "options": [
      {
        "id": "a",
        "text": "A histogram with a bucket at 0.3 s",
        "correct": true,
        "note": "Right. Aggregatable, and accurate at the threshold."
      },
      {
        "id": "b",
        "text": "A summary with a 0.95 quantile",
        "correct": false,
        "note": "Summary quantiles can't be aggregated across instances."
      },
      {
        "id": "c",
        "text": "A gauge of the last request's latency",
        "correct": false,
        "note": "Loses the distribution."
      },
      {
        "id": "d",
        "text": "A summary with a 0.3 s objective",
        "correct": false,
        "note": "Summaries' quantiles still can't be aggregated across instances."
      }
    ],
    "explanation": "Use histograms if you need to aggregate; place a bucket at a known threshold for an accurate fraction.",
    "difficulty": 2,
    "tags": [
      "exam"
    ],
    "uses": [],
    "sources": [
      {
        "url": "https://prometheus.io/docs/practices/histograms/",
        "title": "Histograms and summaries"
