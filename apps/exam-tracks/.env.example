DATABASE_URL="postgresql://exam:exam@localhost:5432/exam_tracks"
AUTH_SECRET="generate-with: npx auth secret"
# Comma-separated emails that get the ADMIN role on first sign-in
ADMIN_EMAILS="you@example.com"
# Optional OAuth providers (enabled only when set)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Magic link email (enabled only when set)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Exam Tracks <no-reply@example.com>"
# Dev-only password-less login (never enabled in production)
DEV_LOGIN="true"
